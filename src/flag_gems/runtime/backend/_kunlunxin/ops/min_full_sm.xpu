#include "min_common.inc"

// ---------------- full-reduction entry (aten::min on a flat tensor) --------
// Per-cluster SM reduction (borrowed from the vendor tensor_calc_scalar
// pattern; mirrors max_full_sm.xpu with MIN polarity): every core reduces its
// slice and publishes a monotonic-int64 key to a per-cluster SM slot; a
// cluster barrier (sync_all) lets core 0 take the MIN over the 64 slots and
// write ONE 8-byte partial per cluster (12 GM slots total). This avoids the
// 768 narrow per-core global stores that are pathologically slow on this
// device (the previous k1 dominated the 1D latency: 2B stores ~+18us).
// min_combine_raw then reduces the 12 slots.
static __shared__ unsigned int sm_partial[64];

static __device__ __attribute__((always_inline)) int f2mi(float x) {
  unsigned u;
  __builtin_memcpy(&u, &x, 4);
  return (u & 0x80000000u) ? ~(int)u : (int)(u | 0x80000000u);
}
static __device__ __attribute__((always_inline)) float mi2f(int m) {
  unsigned u = (unsigned)m;
  // decode: m with the sign bit set came from a positive float (clear it);
  // m with it clear came from a negative float (invert)
  if (u & 0x80000000u) u = u & 0x7FFFFFFFu; else u = ~u;
  float x;
  __builtin_memcpy(&x, &u, 4);
  return x;
}
static __device__ __attribute__((always_inline)) long long f642mi(double x) {
  unsigned long long u;
  __builtin_memcpy(&u, &x, 8);
  return (u & 0x8000000000000000ULL) ? ~(long long)u
                                     : (long long)(u | 0x8000000000000000ULL);
}
static __device__ __attribute__((always_inline)) double mi2f64(long long m) {
  unsigned long long u = (unsigned long long)m;
  if (u & 0x8000000000000000ULL) u = u & 0x7FFFFFFFFFFFFFFFULL; else u = ~u;
  double x;
  __builtin_memcpy(&x, &u, 8);
  return x;
}

// unsigned-ordered key for the SM cluster reduce (float dtypes + i32 only;
// other dtypes fall back to per-core 8B GM partials in min_full_raw). The
// float monotonic keys and the i32 sign-flip are both ordered by UNSIGNED
// compare, which the cluster MIN below uses.
static __device__ __attribute__((always_inline)) unsigned int val_to_key(
    int type_code, float bestf, _Float16 besth, int besti) {
  switch (type_code) {
    case T_F32: return (unsigned int)f2mi(bestf);
    case T_BF16: return (unsigned int)f2mi(bestf);
    case T_F16: return (unsigned int)f2mi((float)besth);
    default: return ((unsigned int)besti) ^ 0x80000000u;  // T_I32
  }
}

static __device__ __attribute__((always_inline)) void key_to_vals(
    unsigned int k, int type_code, float *bestf, _Float16 *besth, int *besti) {
  switch (type_code) {
    case T_F32: *bestf = mi2f((int)k); break;
    case T_BF16: *bestf = mi2f((int)k); break;
    case T_F16: *bestf = mi2f((int)k); *besth = (_Float16)*bestf; break;
    default: *besti = (int)(k ^ 0x80000000u); break;  // T_I32
  }
}

// ---------------- per-lane vvmin accumulate (float dtypes) ----------------
// The per-16/32-lane vsrlp+vvmin tree costs ~8x the ops of a vrmax and
// dominated the 1D latency ([1048576]: 16.0-16.9us vs max's 12.7-13.9us on
// the identical 2-kernel structure). Accumulate per-lane (1 op/vector) and do
// ONE cross-lane tree per core. f16 accumulates natively (vvmin_float16x32);
// bf16 lives in the f32 domain via the packed "top 16 bits" identity. The
// <16-element chunk tail is folded with a scalar running min (f16 in f16,
// f32/bf16 in f32).
static __device__ __attribute__((always_inline)) void acc_f32(
    __local__ char *buf, int len, float32x16_t *a0, float32x16_t *a1,
    float *tail) {
  const __local__ float32x16_t *f = (const __local__ float32x16_t *)buf;
  int nv = len >> 4;
  int i = 0;
  for (; i + 1 < nv; i += 2) {
    *a0 = vvmin_float32x16(*a0, f[i]);
    *a1 = vvmin_float32x16(*a1, f[i + 1]);
  }
  if (i < nv) *a0 = vvmin_float32x16(*a0, f[i]);
  const __local__ float *ff = (const __local__ float *)buf;
  for (int k = nv << 4; k < len; ++k) {
    float x = ff[k];
    if (x < *tail) *tail = x;
  }
}

static __device__ __attribute__((always_inline)) void acc_f16(
    __local__ char *buf, int len, float16x32_t *a, _Float16 *tail) {
  const __local__ float16x32_t *f = (const __local__ float16x32_t *)buf;
  int nv = len >> 5;
  for (int i = 0; i < nv; ++i) *a = vvmin_float16x32(*a, f[i]);
  const __local__ _Float16 *ff = (const __local__ _Float16 *)buf;
  for (int k = nv << 5; k < len; ++k) {
    _Float16 x = ff[k];
    if (x < *tail) *tail = x;
  }
}

static __device__ __attribute__((always_inline)) void acc_bf16(
    __local__ char *buf, int len, float32x16_t *a0, float32x16_t *a1,
    float *tail) {
  const __local__ int32x16_t *w = (const __local__ int32x16_t *)buf;
  int nv = len >> 5;  // 32 bf16 per int32x16
  int i = 0;
  for (; i + 1 < nv; i += 2) {
    int32x16_t pr0 = w[i];
    *a0 = vvmin_float32x16(*a0, (float32x16_t)(pr0 << 16));
    *a1 = vvmin_float32x16(*a1, (float32x16_t)(pr0 & (int32x16_t)(-65536)));
    int32x16_t pr1 = w[i + 1];
    *a0 = vvmin_float32x16(*a0, (float32x16_t)(pr1 << 16));
    *a1 = vvmin_float32x16(*a1, (float32x16_t)(pr1 & (int32x16_t)(-65536)));
  }
  if (i < nv) {
    int32x16_t pr = w[i];
    *a0 = vvmin_float32x16(*a0, (float32x16_t)(pr << 16));
    *a1 = vvmin_float32x16(*a1, (float32x16_t)(pr & (int32x16_t)(-65536)));
  }
  const __local__ unsigned short *ww = (const __local__ unsigned short *)buf;
  for (int k = nv << 5; k < len; ++k) {
    unsigned bits = ((unsigned)ww[k]) << 16;
    float fv = *(float *)&bits;
    if (fv < *tail) *tail = fv;
  }
}

extern "C" __device__ void min_full_raw(
    _global_ptr_ const char *in,
    _global_ptr_ char *mid,
    int M, int esz, int type_code,
    int per, int slot) {
  __attribute__((aligned(64))) __local__ char buf[NBUF][CHUNK_BYTES];
  __local__ float sv_f32[16];
  __local__ _Float16 sv_f16[32];
  __local__ int sv_i32[16];
  __local__ unsigned short sv_bf16[32];

  int cid = core_id();
  int elems_start = (slot * 64 + cid) * per;
  int end = elems_start + per;
  if (end > M) end = M;

  int chunk_elems = CHUNK_BYTES / esz;
  int nch = end > elems_start
                ? (end - elems_start + chunk_elems - 1) / chunk_elems
                : 0;

  float bestf = 0.f;
  _Float16 besth = 0;
  int besti = 0;
  long long bestl = 0;
  short bestw = 0;
  signed char bestb = 0;
  unsigned char bestub = 0;
  double bestd = 0;
  int bidx = 0;
  int first = 1;
  int sv_base = -1;

  int off = elems_start;
  int issued = 0;
  int cur = 0;
  // per-lane vvmin accumulators (float dtypes): one tree per core at the end
  float32x16_t vacc0 = float32x16_t(__builtin_huge_valf());
  float32x16_t vacc1 = float32x16_t(__builtin_huge_valf());
  float16x32_t vacc16 = float16x32_t((_Float16)(__builtin_huge_valf()));
  float tailm = __builtin_huge_valf();
  _Float16 tailh = (_Float16)(__builtin_huge_valf());
  if (nch > 0) {
    int len = end - off < chunk_elems ? end - off : chunk_elems;
    GM2LM_ASYNC(in + (long long)off * esz, buf[0], len * esz);
    issued = 1;
  }
  while (off < end) {
    mfence_lm();
    if (issued < nch) {
      int ioff = elems_start + issued * chunk_elems;
      int ilen = end - ioff < chunk_elems ? end - ioff : chunk_elems;
      GM2LM_ASYNC(in + (long long)ioff * esz, buf[issued & 1], ilen * esz);
      ++issued;
    }
    int len = end - off < chunk_elems ? end - off : chunk_elems;
    switch (type_code) {
      case T_F32:
        acc_f32(buf[cur], len, &vacc0, &vacc1, &tailm);
        break;
      case T_F16:
        acc_f16(buf[cur], len, &vacc16, &tailh);
        break;
      case T_BF16:
        acc_bf16(buf[cur], len, &vacc0, &vacc1, &tailm);
        break;
      case T_I32:
        proc_i32(buf[cur], len, off, &besti, &bidx, &first, sv_i32, &sv_base);
        break;
      case T_I64: proc_i64(buf[cur], len, off, &bestl, &bidx, &first); break;
      case T_I16: proc_i16(buf[cur], len, off, &bestw, &bidx, &first); break;
      case T_I8: proc_i8(buf[cur], len, off, &bestb, &bidx, &first); break;
      case T_U8: proc_u8(buf[cur], len, off, &bestub, &bidx, &first); break;
      default: proc_f64(buf[cur], len, off, &bestd, &bidx, &first); break;
    }
    off += len;
    cur ^= 1;
  }
  // one cross-lane tree per core for the float dtypes
  if (type_code == T_F32 || type_code == T_BF16) {
    float m0 = min_reduce_f32(vacc0);
    float m1 = min_reduce_f32(vacc1);
    bestf = m0 < m1 ? m0 : m1;
    if (tailm < bestf) bestf = tailm;
  } else if (type_code == T_F16) {
    besth = min_reduce_f16(vacc16);
    if (tailh < besth) besth = tailh;
  }
  // float dtypes + i32 take the per-cluster SM reduce (12 GM slots, no narrow
  // stores); other dtypes fall back to per-core 8-byte partials.
  if (type_code == T_F32 || type_code == T_F16 || type_code == T_BF16 ||
      type_code == T_I32) {
    if (nch == 0) {
      // empty cores must publish the min-identity so they never win
      bestf = __builtin_huge_valf();
      besth = (_Float16)(__builtin_huge_valf());
      besti = 0x7FFFFFFF;
    }
    unsigned int key = val_to_key(type_code, bestf, besth, besti);
    sm_partial[cid] = key;
    mfence_sm();
    sync_all();
    if (cid == 0) {
      unsigned int m = sm_partial[0];
      for (int i = 1; i < 64; ++i)
        if (sm_partial[i] < m) m = sm_partial[i];
      key_to_vals(m, type_code, &bestf, &besth, &besti);
      __local__ char pval[8];
      stage_val(pval, 0, esz, bestf, besth, besti, bestl, bestw, bestb,
                bestub, bestd, type_code);
      // one 8-byte partial per cluster (slots 0..11)
      LM2GM(pval, mid + (long long)slot * 8, 8);
    }
  } else {
    _global_ptr_ char *dst = mid + (long long)(slot * 64 + cid) * 8;
    __local__ char pval[8];
    stage_val(pval, 0, esz, bestf, besth, besti, bestl, bestw, bestb,
              bestub, bestd, type_code);
    LM2GM(pval, dst, 8);
  }
  mfence();
}

// ---------------- combine entry: reduce mid[0..n) to one scalar ------------
// Runs on a single core (n is at most nclusters*64); avoids the masked-load
// "other=" pitfalls of the compiler-generated combine kernel.

extern "C" __device__ void min_combine_raw(
    _global_ptr_ const char *mid,
    _global_ptr_ char *out,
    int n, int esz, int type_code) {
  if (core_id() != 0) return;
  // mid holds n 8-byte slots: 12 for the float/i32 SM-reduce path, up to 768
  // for the per-core fallback. Read them in 96B chunks (a single 96B read
  // covers the common 12-slot case).
  __attribute__((aligned(64))) __local__ char buf[12 * 8];
  float bestf = 0.f;
  _Float16 besth = 0;
  int besti = 0;
  long long bestl = 0;
  short bestw = 0;
  signed char bestb = 0;
  unsigned char bestub = 0;
  double bestd = 0;
  int first = 1;
  for (int base = 0; base < n; base += 12) {
    int cnt = n - base < 12 ? n - base : 12;
    GM2LM(mid + (long long)base * 8, buf, cnt * 8);
    for (int kk = 0; kk < cnt; ++kk) {
      int k = base + kk;
      const char *p = buf + kk * 8;
      switch (type_code) {
      case T_F32: {
        float v;
        __builtin_memcpy(&v, p, 4);
        if (first || v < bestf) { bestf = v; first = 0; }
        break;
      }
      case T_F16: {
        unsigned short h;
        __builtin_memcpy(&h, p, 2);
        _Float16 v;
        __builtin_memcpy(&v, &h, 2);
        if (first || v < besth) { besth = v; first = 0; }
        break;
      }
      case T_BF16: {
        unsigned short h;
        __builtin_memcpy(&h, p, 2);
        unsigned bits = ((unsigned)h) << 16;
        float v = *(float *)&bits;
        if (first || v < bestf) { bestf = v; first = 0; }
        break;
      }
      case T_I32: {
        int v;
        __builtin_memcpy(&v, p, 4);
        if (first || v < besti) { besti = v; first = 0; }
        break;
      }
      case T_I64: {
        long long v;
        __builtin_memcpy(&v, p, 8);
        if (first || v < bestl) { bestl = v; first = 0; }
        break;
      }
      case T_I16: {
        short v;
        __builtin_memcpy(&v, p, 2);
        if (first || v < bestw) { bestw = v; first = 0; }
        break;
      }
      case T_I8: {
        signed char v;
        __builtin_memcpy(&v, p, 1);
        if (first || v < bestb) { bestb = v; first = 0; }
        break;
      }
      case T_U8: {
        unsigned char v;
        __builtin_memcpy(&v, p, 1);
        if (first || v < bestub) { bestub = v; first = 0; }
        break;
      }
      default: {
        double v;
        __builtin_memcpy(&v, p, 8);
        if (first || v < bestd) { bestd = v; first = 0; }
        break;
      }
      }
    }
  }
  // NOTE: no f32 identity-clamp here. An all-+inf tensor reduces to +inf,
  // matching torch on CPU (tests/test_min.py::test_min_all_inf with --ref
  // cpu). The device-native f32 min would give FLT_MAX, but the CPU reference
  // semantics win (see min_kernel_1 note in min.py).
  __local__ char pval[8];
  stage_val(pval, 0, esz, bestf, besth, besti, bestl, bestw, bestb, bestub,
            bestd, type_code);
  LM2GM(pval, out, esz);
  mfence();
}